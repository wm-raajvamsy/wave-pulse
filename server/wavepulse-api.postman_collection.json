    {
      "name": "Widget",
      "item": [
        {
          "name": "Get Widget (Properties + Styles)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/widget/{{widgetId}}?channelId={{channelId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "widget", "{{widgetId}}"],
              "query": [
                {
                  "key": "channelId",
                  "value": "{{channelId}}",
                  "description": "The channel ID of the connected mobile app"
                }
              ]
            },
            "description": "Returns both properties and styles for a specific widget.\n\n**Important:** Use the `id` field from the element tree response, not the `name` field.\n\n**Response contains:**\n- `properties`: Widget properties (caption, show, etc.)\n- `styles`: Widget styles organized by part (root, label, etc.)"
          },
          "response": []
